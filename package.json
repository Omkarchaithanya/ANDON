{
  "name": "andon-shadow-radar",
  "version": "1.0.0",
  "description": "Shadow-change radar for robotized workplaces - Codegeist 2026",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "dev": "npm --prefix static/frontend run dev",
    "server": "ts-node scripts/dev-server.ts",
    "verify:backend": "ts-node scripts/verify-backend.ts",
    "verify:mechanisms": "ts-node test/run-all-checks.js",
    "eval:run": "ts-node evals/run-evals.js",
    "llm:smoke": "ts-node scripts/run-llm-smoke.js",
    "build": "cd static/frontend && npm run build",
    "test": "jest --config jest.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "ci": "node scripts/check-node.js && npm run lint && npm run test && node scripts/no-fakes.js && node scripts/secret-scan.js && npm run eval:run && npm run verify:mechanisms"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@forge/api": "^4.0.0",
    "@forge/events": "^1.0.0",
    "@forge/llm": "^0.3.0",
    "@forge/realtime": "^0.3.0",
    "@forge/resolver": "^1.6.0",
    "@forge/sql": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
